# brik toy format v1
# Classic Solid Brick House (4x4 studs footprint: Width 8, Depth 8, Height 6)

# --- Layer 1 (Y = 0.5) ---
# Front wall (White door on right, Yellow on left)
brick -2 0.5 4 Yellow
brick 2 0.5 4 White

# Back wall
brick -2 0.5 -4 Yellow
brick 2 0.5 -4 Yellow

# Side walls (Rotated 90 deg)
brick -4 0.5 0 Yellow 0 90 0
brick 4 0.5 0 Yellow 0 90 0


# --- Layer 2 (Y = 1.5) ---
# Front wall with Windows (Cyan)
brick -2 1.5 4 Cyan
brick 2 1.5 4 White

# Back wall
brick -2 1.5 -4 Yellow
brick 2 1.5 -4 Yellow

# Side walls
brick -4 1.5 0 Yellow 0 90 0
brick 4 1.5 0 Yellow 0 90 0


# --- Layer 3 (Y = 2.5) ---
# Front header
brick -2 2.5 4 Yellow
brick 2 2.5 4 Yellow

# Back wall
brick -2 2.5 -4 Yellow
brick 2 2.5 -4 Yellow

# Side walls
brick -4 2.5 0 Yellow 0 90 0
brick 4 2.5 0 Yellow 0 90 0


# --- Layer 4: Lower Roof (Y = 3.5) ---
brick -3 3.5 3 Red
brick 3 3.5 3 Red
brick -3 3.5 -3 Red
brick 3 3.5 -3 Red


# --- Layer 5: Upper Roof (Y = 4.5) ---
brick -2 4.5 0 Red
brick 2 4.5 0 Red


# --- Chimney (Y = 5.5 & 6.5) ---
brick 2 5.5 -2 Grey
brick 2 6.5 -2 White

